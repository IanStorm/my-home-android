{
  "name": "@ianstorm/my-home-android",
  "version": "0.0.0",
  "description": "Non-public configuration for all Android devices in my home.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:**",
    "dev:app": "vite --host",
    "dev:test": "vitest --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm-run-all --serial -c test:**",
    "test:1-lint": "eslint .",
    "test:2-deps": "depcheck",
    "test:3-unit": "vitest --run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IanStorm/my-home-android.git"
  },
  "author": {
    "name": "Christian Sporer",
    "url": "https://github.com/IanStorm"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/IanStorm/my-home-android#readme",
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.16.1",
    "@mui/material": "^5.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^1.8.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/lodash": "^4.17.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^25.0.1",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
